{
  "title": "Microservices Dashboard",
  "uid": "microservices",
  "schemaVersion": 38,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP リクエスト数（秒間）",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count[1m])",
          "legendFormat": "{{application}} {{uri}} {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP レイテンシ P99（秒）",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket[1m]))",
          "legendFormat": "{{application}} {{uri}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM ヒープ使用量",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "{{application}} {{id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM スレッド数",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "jvm_threads_live_threads",
          "legendFormat": "{{application}}"
        }
      ]
    }
  ],
  "time": { "from": "now-15m", "to": "now" }
}
